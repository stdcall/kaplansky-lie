#import "bibliography-data.typ": bibliography-data

// A record prints from its `annotation`: a template that gives the order of
// the fields and the punctuation of the printed record, as in the book:
// "{nameaddon} ({author}), {title}, _{journaltitle}_, *{volume}* ({date}),
// {pages}.". {field} is a field of the record, {Key.field} a field of a record
// named in its `related` (the Russian translation). _…_ in the template is
// italic (the journal), *…* bold (the volume); "…" are «…». In the values, _…_
// is italic and $…$ a formula.
//
// - author: "Surname, Initials and …", printed "SURNAME Initials, …" in the
//   record itself and "Surname Initials" in its translation;
// - nameaddon: the Russian transcription of foreign names, in capitals as
//   printed, before the original names in parentheses;
// - journaltitle, series: their verified abbreviation (shortjournal,
//   shortseries) when it is the one printed, else userb, the spelling printed
//   in the book, else the full title;
// - volume and number may carry the running number in parentheses;
//   pages "a--b" print as "a–b".
#let nbsp = "\u{00A0}"
#let template-text(value) = value.replace(
  regex("(№|\\b(?:т|v|с|p|вып|гл)\\.) "),
  it => it.captures.first() + nbsp,
)
#let rich-bib-text(value) = {
  let value = (
    value
      .replace("'", "’")
      .replace(" — ", nbsp + "— ")
      .replace(" // ", nbsp + "// ")
  )
  let position = 0
  for match in value.matches(regex("\\$[^$]+\\$|_[^_]+_")) {
    value.slice(position, match.start)
    let part = match.text
    if part.starts-with("_") {
      emph(part.slice(1, -1))
    } else {
      eval(part, mode: "markup")
    }
    position = match.end
  }
  value.slice(position)
}
// "Блок, Р. and Цассенхауз, Г." prints "Блок Р., Цассенхауз Г.": the
// initials stay with the surname.
#let bib-names(value) = (
  value
    .split(" and ")
    .map(name => {
      let (surname, ..initials) = name.split(", ")
      if initials.len() == 0 { surname } else {
        surname + nbsp + initials.join(", ").replace(" ", nbsp)
      }
    })
    .join(", ")
)
#let short-field = (
  journal: "shortjournal",
  journaltitle: "shortjournal",
  series: "shortseries",
)
#let bib-field(data, field, capitals: true) = {
  if field == "author" {
    let names = bib-names(data.author)
    rich-bib-text(if capitals { upper(names) } else { names })
  } else if field in ("journal", "journaltitle", "series", "booktitle") {
    let short = short-field.at(field, default: none)
    let full = if field in data { field } else if field == "journal" {
      "journaltitle"
    } else if field == "journaltitle" { "journal" } else { field }
    let shown = if short != none and short in data { data.at(short) } else if (
      "userb" in data
    ) { data.userb } else { data.at(full) }
    rich-bib-text(shown)
  } else if field == "pages" {
    rich-bib-text(data.at(field).replace("--", "–").replace("-", "–"))
  } else {
    rich-bib-text(data.at(field))
  }
}
#let bib-backlinks(target) = context {
  let starts = query(<bibliography-start>)
  // The book body precedes the bibliography. Avoid querying the metadata
  // generated by these backlinks, which would depend on their own layout.
  let candidates = if starts.len() == 1 {
    query(selector(<bibliography-mention>).before(starts.first().location()))
  } else { query(<bibliography-mention>) }
  let refs = candidates.filter(it => it.value.target == target)
  let seen = ()
  let pages = ()
  for mention in refs {
    let loc = mention.location()
    if not seen.contains(loc.page()) {
      seen.push(loc.page())
      let position = loc.position()
      let destination = (
        page: position.page,
        x: position.x,
        y: calc.max(0pt, position.y - 8pt),
      )
      let pattern = loc.page-numbering()
      let folio = counter(page).at(loc)
      let shown = if pattern == none { str(folio.first()) } else {
        numbering(pattern, ..folio)
      }
      pages.push(box(context [
        #metadata((
          kind: "page-reference",
          resolved: true,
          target: "bib-mention:" + target,
          position: here().position(),
          target-position: position,
          // Typst adds 10pt above the coordinate destination as well.
          destination-offset-pt: 18,
          description: shown,
        ))
        #link(destination, shown)
      ]))
    }
  }
  if pages.len() > 0 { [ #text(size: 9pt)[\[#pages.join(", ")\]]] }
}

#let bib-description(key, backlinks: true) = {
  let entry = bibliography-data.at(key)
  let related = entry.at("related", default: "").split(",").filter(k => k != "")
  // Text between underscores of the template is italic; the template
  // itself has no other underscores.
  let segments = entry
    .annotation
    .split("\"")
    .enumerate()
    .map(((i, part)) => if i == 0 { part } else {
      (if calc.odd(i) { "«" } else { "»" }) + part
    })
    .join()
    .split("_")
  for (index, segment) in segments.enumerate() {
    let printed = {
      let position = 0
      let bold = false
      for match in segment.matches(regex("\\*|\\{([^{}]+)\\}")) {
        rich-bib-text(template-text(segment.slice(position, match.start)))
        position = match.end
        if match.text == "*" {
          bold = not bold
          continue
        }
        let token = match.captures.first().split(".")
        let data = if token.len() == 1 { entry } else {
          assert(
            token.first() in related,
            message: "Template references an unrelated bibliography record",
          )
          bibliography-data.at(token.first())
        }
        let field = bib-field(data, token.last(), capitals: token.len() == 1)
        if bold { strong(field) } else { field }
      }
      rich-bib-text(template-text(segment.slice(position)))
    }
    if calc.odd(index) { emph(printed) } else { printed }
  }

  for component in (key,) + related {
    let record = bibliography-data.at(component)
    if "doi" in record {
      let part = if "userc" in record { " (" + record.userc + ")" } else { "" }
      [
        #link(
          "https://doi.org/" + record.doi,
          // A line may end after the slash, even before a digit; the spacing
          // adds no character to the text of the DOI.
          [DOI#part: #record.doi.split("/").join([/#h(0pt)])],
        )]
    } else if "url" in record {
      [ #link(record.url)[Текст]]
    }
  }
  if backlinks { bib-backlinks("bib:" + key) }
}
