import Mathlib.Algebra.Lie.Basic
import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Products of ideals and the lower central series of a Lie ring

Chapter I, § 2, theorems 4, 6, 7, 8, 9, pp. 19-21, for Lie rings.  The book states them
for Lie algebras and remarks that it fixes algebras only for definiteness; additive
subgroups cover both.  Notation of the book and of this file:

* `L` is a Lie ring, `a b` of the book is `⁅a, b⁆`;
* the product `I J` of two additive subgroups is the set of finite SUMS of products
  (the remark after theorem 4): `prod I J`, the additive subgroup generated by the `⁅x, y⁆`;
* an ideal: `IsIdeal I`, that is `I` is an additive subgroup with `⁅x, a⁆ ∈ I` for `x ∈ I`
  (left and right ideals coincide by antisymmetry);
* the lower central series `I_1 = I`, `I_(n+1) = I I_n` of the algebra `I`, with `I_0 = L` as in
  the proof of theorem 8: `lc I n`;
* the derived series `L^(0) = L`, `L^(n+1) = (L^(n))^2`: `der n`.

Declarations:

* `prod_isIdeal`: theorem 4, the product of two ideals is an ideal;
* `lc_isIdeal`: each `I_n` is an ideal of `L` for an ideal `I`, as theorem 8 needs;
* `lower_central_product`: theorem 7, `I_i I_j ⊆ I_(i+j)` for `i, j ≥ 1` and any additive
  subgroup `I`; for `I = ⊤` this is the printed statement `L_i L_j ⊆ L_(i+j)`;
* `der_le_lc`: the first statement of theorem 6, `L^(n) ⊆ L_(n+1)`;
* `Word`, `Word.eval`, `Word.count`, `eval_mem_lc`: theorem 8, a product of `L`-elements with
  any bracketing, `r` of them in `I`, lies in `I_r`;
* `lc_sup_eq_bot`: theorem 9, `I_m = 0`, `J_n = 0` imply `(I + J)_(m+n-1) = 0`.

Not covered: the second statement of theorem 6 and theorem 10 (immediate);
the finite-dimensional statements; scalars (the statements are for additive subgroups, and
a subspace is one, with `prod` then being the additive subgroup generated by the products, which
is already a subspace).  The same statements are tested on all ideals of a list of finite Lie
algebras in `checks/sage/chapter-1a.py`, section 2.
-/

namespace KaplanskyLie.IdealProducts

variable {L : Type*} [LieRing L]

/-- The product `I J` of the book: the additive subgroup generated by the products. -/
def prod (A B : AddSubgroup L) : AddSubgroup L :=
  AddSubgroup.closure {z | ∃ a ∈ A, ∃ b ∈ B, ⁅a, b⁆ = z}

/-- `I` is an ideal of `L`. -/
def IsIdeal (I : AddSubgroup L) : Prop := ∀ x ∈ I, ∀ a : L, ⁅x, a⁆ ∈ I

theorem lie_mem_prod {A B : AddSubgroup L} {a b : L} (ha : a ∈ A) (hb : b ∈ B) :
    ⁅a, b⁆ ∈ prod A B :=
  AddSubgroup.subset_closure ⟨a, ha, b, hb, rfl⟩

theorem prod_le {A B C : AddSubgroup L} (h : ∀ a ∈ A, ∀ b ∈ B, ⁅a, b⁆ ∈ C) : prod A B ≤ C := by
  refine (AddSubgroup.closure_le C).2 ?_
  rintro _ ⟨a, ha, b, hb, rfl⟩
  exact h a ha b hb

theorem prod_mono {A A' B B' : AddSubgroup L} (h : A ≤ A') (h' : B ≤ B') :
    prod A B ≤ prod A' B' :=
  prod_le fun _ ha _ hb => lie_mem_prod (h ha) (h' hb)

/-- `⁅a, z⁆ ∈ C` for all `z ∈ A B` as soon as this holds on the products. -/
theorem lie_right_mem_of_prod {A B C : AddSubgroup L} {a z : L} (hz : z ∈ prod A B)
    (h : ∀ x ∈ A, ∀ y ∈ B, ⁅a, ⁅x, y⁆⁆ ∈ C) : ⁅a, z⁆ ∈ C := by
  induction hz using AddSubgroup.closure_induction with
  | mem z hz =>
      rcases hz with ⟨x, hx, y, hy, rfl⟩
      exact h x hx y hy
  | zero => simp
  | add u v _ _ hu hv => rw [lie_add]; exact C.add_mem hu hv
  | neg u _ hu => rw [lie_neg]; exact C.neg_mem hu

/-- Theorem 4: the product of two ideals of a Lie ring is an ideal. -/
theorem prod_isIdeal {I J : AddSubgroup L} (hI : IsIdeal I) (hJ : IsIdeal J) :
    IsIdeal (prod I J) := by
  intro z hz c
  induction hz using AddSubgroup.closure_induction with
  | mem z hz =>
      rcases hz with ⟨x, hx, y, hy, rfl⟩
      -- `x y · c = x · y c + x c · y`, the Jacobi identity of the proof
      have key : ⁅⁅x, y⁆, c⁆ = ⁅x, ⁅y, c⁆⁆ + ⁅⁅x, c⁆, y⁆ := by
        have := leibniz_lie x y c
        have h2 : ⁅y, ⁅x, c⁆⁆ = -⁅⁅x, c⁆, y⁆ := by rw [lie_skew]
        rw [this, h2]
        abel
      rw [key]
      exact (prod I J).add_mem (lie_mem_prod hx (hJ y hy c)) (lie_mem_prod (hI x hx c) hy)
  | zero => simp
  | add u v _ _ hu hv => rw [add_lie]; exact (prod I J).add_mem hu hv
  | neg u _ hu => rw [neg_lie]; exact (prod I J).neg_mem hu

/-- The lower central series `I_1 = I`, `I_(n+1) = I I_n`, and `I_0 = L` as in theorem 8. -/
def lc (I : AddSubgroup L) : ℕ → AddSubgroup L
  | 0 => ⊤
  | 1 => I
  | (n + 2) => prod I (lc I (n + 1))

theorem lc_isIdeal {I : AddSubgroup L} (hI : IsIdeal I) : ∀ n, IsIdeal (lc I n)
  | 0 => fun _ _ _ => AddSubgroup.mem_top _
  | 1 => hI
  | (n + 2) => prod_isIdeal hI (lc_isIdeal hI (n + 1))

theorem lc_succ_le {I : AddSubgroup L} (hI : IsIdeal I) : ∀ n, lc I (n + 1) ≤ lc I n
  | 0 => le_top
  | 1 => prod_le fun a ha _ _ => hI a ha _
  | (n + 2) => prod_mono le_rfl (lc_succ_le hI (n + 1))

theorem lc_anti {I : AddSubgroup L} (hI : IsIdeal I) {m n : ℕ} (h : m ≤ n) : lc I n ≤ lc I m := by
  induction h with
  | refl => exact le_rfl
  | step _ ih => exact (lc_succ_le hI _).trans ih

/-- The case `j = 1` of theorem 7. -/
theorem lie_lc_right {I : AddSubgroup L} {a b : L} {i : ℕ} (ha : a ∈ lc I (i + 1)) (hb : b ∈ I) :
    ⁅a, b⁆ ∈ lc I (i + 2) := by
  have : ⁅a, b⁆ = -⁅b, a⁆ := (lie_skew a b).symm
  rw [this]
  exact (lc I (i + 2)).neg_mem (lie_mem_prod hb ha)

/-- Theorem 7: `I_i I_j ⊆ I_(i+j)`, written for `i + 1`, `j + 1`.  No ideal is needed. -/
theorem lower_central_product (I : AddSubgroup L) (j : ℕ) :
    ∀ i, prod (lc I (i + 1)) (lc I (j + 1)) ≤ lc I (i + j + 2) := by
  induction j with
  | zero =>
      intro i
      exact prod_le fun a ha b hb => lie_lc_right ha hb
  | succ j ih =>
      intro i
      refine prod_le fun a ha z hz => ?_
      refine lie_right_mem_of_prod hz fun b hb c hc => ?_
      -- `a · b c = a b · c + b · a c`, formula (3) of the proof
      rw [leibniz_lie a b c]
      refine (lc I (i + (j + 1) + 2)).add_mem ?_ ?_
      · have h1 : ⁅a, b⁆ ∈ lc I (i + 1 + 1) := lie_lc_right ha hb
        have := ih (i + 1) (lie_mem_prod h1 hc)
        have e : i + 1 + j + 2 = i + (j + 1) + 2 := by omega
        rwa [e] at this
      · have h2 : ⁅a, c⁆ ∈ lc I (i + j + 2) := ih i (lie_mem_prod ha hc)
        have : ⁅b, ⁅a, c⁆⁆ ∈ prod I (lc I (i + j + 2)) := lie_mem_prod hb h2
        exact this

/-- The derived series of `L`. -/
def der (L : Type*) [LieRing L] : ℕ → AddSubgroup L
  | 0 => ⊤
  | (n + 1) => prod (der L n) (der L n)

/-- Theorem 6, first statement: `L^(n) ⊆ L_(n+1)`. -/
theorem der_le_lc : ∀ n, der L n ≤ lc (⊤ : AddSubgroup L) (n + 1)
  | 0 => le_rfl
  | (n + 1) => prod_le fun _ _ _ hb =>
      lie_mem_prod (AddSubgroup.mem_top _) (der_le_lc n hb)

/-- A product of elements of `L` with some bracketing. -/
inductive Word (L : Type*) : Type _
  | leaf : L → Word L
  | node : Word L → Word L → Word L

/-- The value of a bracketed product. -/
def Word.eval : Word L → L
  | .leaf x => x
  | .node u v => ⁅u.eval, v.eval⁆

open Classical in
/-- The number of factors of a bracketed product that lie in `I`. -/
noncomputable def Word.count (I : AddSubgroup L) : Word L → ℕ
  | .leaf x => if x ∈ I then 1 else 0
  | .node u v => u.count I + v.count I

/-- The number of factors. -/
def Word.size : Word L → ℕ
  | .leaf _ => 1
  | .node u v => u.size + v.size

/-- All factors lie in `I` or in `J`. -/
def Word.AllIn (I J : AddSubgroup L) : Word L → Prop
  | .leaf x => x ∈ I ∨ x ∈ J
  | .node u v => u.AllIn I J ∧ v.AllIn I J

/-- Theorem 8: a product with `r` factors in the ideal `I` lies in `I_r`. -/
theorem eval_mem_lc {I : AddSubgroup L} (hI : IsIdeal I) : ∀ w : Word L, w.eval ∈ lc I (w.count I)
  | .leaf x => by
      by_cases h : x ∈ I
      · simp [Word.count, Word.eval, h, lc]
      · simp [Word.count, Word.eval, h, lc]
  | .node u v => by
      have hu := eval_mem_lc hI u
      have hv := eval_mem_lc hI v
      show ⁅u.eval, v.eval⁆ ∈ lc I (u.count I + v.count I)
      rcases hp : u.count I with _ | p
      · rw [hp] at hu
        rw [Nat.zero_add]
        have : ⁅u.eval, v.eval⁆ = -⁅v.eval, u.eval⁆ := (lie_skew _ _).symm
        rw [this]
        exact (lc I _).neg_mem (lc_isIdeal hI _ _ hv _)
      · rcases hq : v.count I with _ | q
        · rw [hp] at hu
          exact lc_isIdeal hI _ _ hu _
        · rw [hp] at hu
          rw [hq] at hv
          have := lower_central_product I q p (lie_mem_prod hu hv)
          have e : p + 1 + (q + 1) = p + q + 2 := by omega
          rwa [e]

theorem count_add_count_ge (I J : AddSubgroup L) :
    ∀ w : Word L, w.AllIn I J → w.size ≤ w.count I + w.count J
  | .leaf x, h => by
      rcases h with h | h <;> by_cases h' : x ∈ I <;> by_cases h'' : x ∈ J <;>
        simp_all [Word.size, Word.count]
  | .node u v, h => by
      have h1 := count_add_count_ge I J u h.1
      have h2 := count_add_count_ge I J v h.2
      simp only [Word.size, Word.count]
      omega

/-- The values of the products of exactly `k` factors from `I ∪ J`. -/
def wordSpan (I J : AddSubgroup L) (k : ℕ) : AddSubgroup L :=
  AddSubgroup.closure {z | ∃ w : Word L, w.AllIn I J ∧ w.size = k ∧ w.eval = z}

theorem lie_mem_wordSpan {I J : AddSubgroup L} {k : ℕ} {c y : L} (hc : c ∈ I ∨ c ∈ J)
    (hy : y ∈ wordSpan I J k) : ⁅c, y⁆ ∈ wordSpan I J (k + 1) := by
  induction hy using AddSubgroup.closure_induction with
  | mem z hz =>
      rcases hz with ⟨w, hw, hs, rfl⟩
      refine AddSubgroup.subset_closure ⟨.node (.leaf c) w, ⟨hc, hw⟩, ?_, rfl⟩
      simp only [Word.size, hs]
      omega
  | zero => simp
  | add u v _ _ hu hv => rw [lie_add]; exact (wordSpan I J _).add_mem hu hv
  | neg u _ hu => rw [lie_neg]; exact (wordSpan I J _).neg_mem hu

/-- Every element of `(I + J)_k` is a sum of products of `k` factors from `I ∪ J`. -/
theorem lc_sup_le_wordSpan (I J : AddSubgroup L) : ∀ k, lc (I ⊔ J) (k + 1) ≤ wordSpan I J (k + 1)
  | 0 => by
      intro x hx
      obtain ⟨a, ha, b, hb, rfl⟩ := AddSubgroup.mem_sup.1 hx
      refine (wordSpan I J 1).add_mem ?_ ?_
      · exact AddSubgroup.subset_closure ⟨.leaf a, Or.inl ha, rfl, rfl⟩
      · exact AddSubgroup.subset_closure ⟨.leaf b, Or.inr hb, rfl, rfl⟩
  | k + 1 => by
      refine prod_le fun a ha y hy => ?_
      have hy' := lc_sup_le_wordSpan I J k hy
      obtain ⟨a₁, ha₁, a₂, ha₂, rfl⟩ := AddSubgroup.mem_sup.1 ha
      rw [add_lie]
      exact (wordSpan I J _).add_mem (lie_mem_wordSpan (Or.inl ha₁) hy')
        (lie_mem_wordSpan (Or.inr ha₂) hy')

/-- Theorem 9: if `I`, `J` are ideals with `I_m = 0`, `J_n = 0`, `m, n ≥ 1`, then
`(I + J)_(m+n-1) = 0`; in particular the sum of two nilpotent ideals is nilpotent. -/
theorem lc_sup_eq_bot {I J : AddSubgroup L} (hI : IsIdeal I) (hJ : IsIdeal J) {m n : ℕ}
    (hm : 1 ≤ m) (hn : 1 ≤ n) (h₁ : lc I m = ⊥) (h₂ : lc J n = ⊥) :
    lc (I ⊔ J) (m + n - 1) = ⊥ := by
  obtain ⟨k, hk⟩ : ∃ k, m + n - 1 = k + 1 := ⟨m + n - 2, by omega⟩
  rw [hk]
  refine le_bot_iff.1 ((lc_sup_le_wordSpan I J k).trans ?_)
  refine (AddSubgroup.closure_le _).2 ?_
  rintro _ ⟨w, hw, hs, rfl⟩
  have hc := count_add_count_ge I J w hw
  have hcases : m ≤ w.count I ∨ n ≤ w.count J := by omega
  rcases hcases with h | h
  · have := lc_anti hI h (eval_mem_lc hI w)
    rw [h₁] at this
    exact this
  · have := lc_anti hJ h (eval_mem_lc hJ w)
    rw [h₂] at this
    exact this

end KaplanskyLie.IdealProducts

