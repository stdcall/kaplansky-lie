import Mathlib.Algebra.Lie.Basic
import Mathlib.Algebra.Group.Action.Opposite
import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Algebra.Module.Defs

/-!
# The image of an ideal in a representation

Chapter I, § 2, theorem 19, p. 29: if `S` is a representation of a Lie algebra `L` in `V` and `I` is
an ideal of `L`, then `V S(I)` is an invariant subspace.  The transformations are elements of a
ring `R` acting on the right of `V`, as in the book: `V` is a module over the opposite ring, and
`v <• r` is `v r`.  A representation is an additive `S : L → R` with `S_(x y) = S_x S_y - S_y S_x`;
`V S(I)` is the additive subgroup generated by the `v S_x` with `v ∈ V`, `x ∈ I`.

* `rep_identity`: the display of the proof, `v S_x S_y = v S_(x y) + (v S_y) S_x`.
* `image_invariant`: theorem 19.

Not covered: theorem 20, whose proof also needs theorem 11; scalars (for a representation of
an algebra the additive subgroup generated is a subspace, since `S` and the action are linear).
-/

namespace KaplanskyLie.InvariantSubspace

open scoped RightActions

variable {L R V : Type*} [LieRing L] [Ring R] [AddCommGroup V] [Module Rᵐᵒᵖ V]

theorem rsmul_rsmul (x : V) (a b : R) : x <• a <• b = x <• (a * b) := by
  show MulOpposite.op b • MulOpposite.op a • x = MulOpposite.op (a * b) • x
  rw [smul_smul, MulOpposite.op_mul]

/-- The set `V S(I)`. -/
def image (S : L → R) (I : AddSubgroup L) : AddSubgroup V :=
  AddSubgroup.closure {w | ∃ v : V, ∃ x ∈ I, v <• S x = w}

/-- The display of the proof: `v S_x S_y = v S_(x y) + (v S_y) S_x`. -/
theorem rep_identity (S : L → R) (hS : ∀ x y, S ⁅x, y⁆ = S x * S y - S y * S x) (v : V) (x y : L) :
    v <• S x <• S y = v <• S ⁅x, y⁆ + (v <• S y) <• S x := by
  rw [rsmul_rsmul, rsmul_rsmul, hS]
  have e : S x * S y = (S x * S y - S y * S x) + S y * S x := by abel
  conv_lhs => rw [e]
  rw [MulOpposite.op_add, add_smul]

/-- Theorem 19: `V S(I)` is invariant under `S(L)`. -/
theorem image_invariant (S : L → R) (hS : ∀ x y, S ⁅x, y⁆ = S x * S y - S y * S x)
    (I : AddSubgroup L) (hI : ∀ x ∈ I, ∀ a : L, ⁅x, a⁆ ∈ I) (w : V)
    (hw : w ∈ image (V := V) S I) (y : L) : w <• S y ∈ image (V := V) S I := by
  induction hw using AddSubgroup.closure_induction with
  | mem w hw =>
      rcases hw with ⟨v, x, hx, rfl⟩
      rw [rep_identity S hS]
      refine (image S I).add_mem ?_ ?_
      · exact AddSubgroup.subset_closure ⟨v, _, hI x hx y, rfl⟩
      · exact AddSubgroup.subset_closure ⟨_, x, hx, rfl⟩
  | zero => simp
  | add u v _ _ hu hv =>
      rw [smul_add]
      exact (image S I).add_mem hu hv
  | neg u _ hu =>
      rw [smul_neg]
      exact (image S I).neg_mem hu

end KaplanskyLie.InvariantSubspace

#print axioms KaplanskyLie.InvariantSubspace.rep_identity
#print axioms KaplanskyLie.InvariantSubspace.image_invariant
